From 2ee6b9365ed6439892497daa9c48b80c71e3632c Mon Sep 17 00:00:00 2001
From: Emil Renner Berthing <emil.renner.berthing@canonical.com>
Date: Wed, 13 Dec 2023 01:52:54 +0100
Subject: [PATCH 09/53] riscv: dts: thead: Add BeagleV Ahead SDIO0 pins

Signed-off-by: Emil Renner Berthing <emil.renner.berthing@canonical.com>
---
 arch/riscv/boot/dts/thead/th1520-beaglev-ahead.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/riscv/boot/dts/thead/th1520-beaglev-ahead.dts b/arch/riscv/boot/dts/thead/th1520-beaglev-ahead.dts
index caa739c0442f..d293152afe10 100644
--- a/arch/riscv/boot/dts/thead/th1520-beaglev-ahead.dts
+++ b/arch/riscv/boot/dts/thead/th1520-beaglev-ahead.dts
@@ -250,6 +250,18 @@ i2c-pins {
 		};
 	};
 
+	sdio0_pins: sdio0-0 {
+		detn-pins {
+			pins = "SDIO0_DETN";
+			function = "sdio";
+			bias-disable; /* external pull-up */
+			drive-strength = <1>;
+			input-enable;
+			input-schmitt-enable;
+			slew-rate = <0>;
+		};
+	};
+
 	uart0_pins: uart0-0 {
 		tx-pins {
 			pins = "UART0_TXD";
@@ -315,6 +327,8 @@ i2c-pins {
 };
 
 &sdio0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdio0_pins>;
 	bus-width = <4>;
 	max-frequency = <198000000>;
 	status = "okay";
-- 
2.52.0

