From ef0050d212b2e7952e3db13c1c603d1104cd7f55 Mon Sep 17 00:00:00 2001
From: Emil Renner Berthing <emil.renner.berthing@canonical.com>
Date: Sun, 31 Dec 2023 22:22:30 +0100
Subject: [PATCH 19/46] riscv: dts: thead: Add Lichee Pi 4A bluetooth

Signed-off-by: Emil Renner Berthing <emil.renner.berthing@canonical.com>
---
 .../boot/dts/thead/th1520-lichee-pi-4a.dts    | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)

diff --git a/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts b/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
index 30a5183f35e7..8eeb40d35990 100644
--- a/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
+++ b/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
@@ -242,6 +242,17 @@ rx-pins {
 };
 
 &padctrl1_apsys {
+	bluetooth_pins: bluetooth-0 {
+		host-wake-pins {
+			pins = "GPIO0_28";
+			bias-disable;
+			drive-strength = <1>;
+			input-enable;
+			input-schmitt-enable;
+			slew-rate = <0>;
+		};
+	};
+
 	i2c0_pins: i2c0-0 {
 		i2c-pins {
 			pins = "I2C0_SCL", "I2C0_SDA";
@@ -310,6 +321,48 @@ rx-pins {
 		};
 	};
 
+	uart4_pins: uart4-0 {
+		tx-pins {
+			pins = "UART4_TXD";
+			function = "uart";
+			bias-disable;
+			drive-strength = <13>;
+			input-disable;
+			input-schmitt-disable;
+			slew-rate = <0>;
+		};
+
+		rx-pins {
+			pins = "UART4_RXD";
+			function = "uart";
+			bias-pull-up;
+			drive-strength = <1>;
+			input-enable;
+			input-schmitt-enable;
+			slew-rate = <0>;
+		};
+
+		cts-pins {
+			pins = "UART4_CTSN";
+			function = "uart";
+			bias-pull-down;
+			drive-strength = <1>;
+			input-enable;
+			input-schmitt-enable;
+			slew-rate = <0>;
+		};
+
+		rts-pins {
+			pins = "UART4_RTSN";
+			function = "uart";
+			bias-disable;
+			drive-strength = <13>;
+			input-disable;
+			input-schmitt-disable;
+			slew-rate = <0>;
+		};
+	};
+
 	vcc5v_usb_pins: vcc5v-usb-0 {
 		enable-pins {
 			pins = "GPIO1_22";
@@ -355,6 +408,20 @@ &uart3 {
 	status = "okay";
 };
 
+&uart4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart4_pins>, <&bluetooth_pins>;
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth {
+		compatible = "realtek,rtl8723ds-bt";
+		device-wake-gpios = <&ioexp2 7 GPIO_ACTIVE_HIGH>; /* BT_HOST_WAKE_DEV */
+		host-wake-gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>; /* BT_DEV_WAKE_HOST / GPIO02 */
+		enable-gpios = <&ioexp2 5 GPIO_ACTIVE_HIGH>; /* BT_RESETN */
+	};
+};
+
 &usb {
 	status = "okay";
 	vbus-supply = <&vcc5v_usb>;
-- 
2.51.0

