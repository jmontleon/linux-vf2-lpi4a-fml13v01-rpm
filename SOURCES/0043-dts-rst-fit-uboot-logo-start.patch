From 8e816b8b39a390e56093b56d6162a7016e4e99c0 Mon Sep 17 00:00:00 2001
From: keith zhao <keith.zhao@starfivetech.com>
Date: Fri, 22 Nov 2024 17:15:59 +0800
Subject: [PATCH 43/46] dts: rst: fit uboot logo start

fix the uboot logo can not display kernel

Signed-off-by: keith zhao <keith.zhao@starfivetech.com>
---
 arch/riscv/boot/dts/starfive/jh7110.dtsi | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/riscv/boot/dts/starfive/jh7110.dtsi b/arch/riscv/boot/dts/starfive/jh7110.dtsi
index 37e623bca151..da2a0a9dc0d9 100644
--- a/arch/riscv/boot/dts/starfive/jh7110.dtsi
+++ b/arch/riscv/boot/dts/starfive/jh7110.dtsi
@@ -1225,10 +1225,13 @@ dc8200: lcd-controller@29400000 {
 				<&voutcrg JH7110_VOUTCLK_DC8200_PIX>;
 			clock-names = "noc_bus", "dc_core", "axi_core", "ahb",
 				      "channel0", "channel1", "hdmi_tx", "dc_parent";
-			resets = <&voutcrg JH7110_VOUTRST_DC8200_AXI>,
+
+			resets = <&syscrg JH7110_SYSRST_NOC_BUS_DISP_AXI>,
+				 <&syscrg JH7110_SYSRST_VOUT_TOP_SRC>,
+				 <&voutcrg JH7110_VOUTRST_DC8200_AXI>,
 				 <&voutcrg JH7110_VOUTRST_DC8200_AHB>,
 				 <&voutcrg JH7110_VOUTRST_DC8200_CORE>;
-			reset-names = "axi","ahb", "core";
+			reset-names = "noc" ,"src" , "axi" ,"ahb", "core";
 		};
 
 		hdmi: hdmi@29590000 {
-- 
