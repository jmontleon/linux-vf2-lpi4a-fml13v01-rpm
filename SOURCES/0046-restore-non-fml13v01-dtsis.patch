From bd37241c5e56995ef6963771c86b3172da4153fe Mon Sep 17 00:00:00 2001
From: Jason Montleon <jmontleo@redhat.com>
Date: Mon, 25 Aug 2025 12:45:23 -0400
Subject: [PATCH 46/46] restore non fml13v01 dtsis

---
 .../boot/dts/starfive/jh7110-common.dtsi      | 135 ------------------
 arch/riscv/boot/dts/starfive/jh7110.dtsi      |  56 +-------
 2 files changed, 4 insertions(+), 187 deletions(-)

diff --git a/arch/riscv/boot/dts/starfive/jh7110-common.dtsi b/arch/riscv/boot/dts/starfive/jh7110-common.dtsi
index d72f38c50730..4baeb981d4df 100644
--- a/arch/riscv/boot/dts/starfive/jh7110-common.dtsi
+++ b/arch/riscv/boot/dts/starfive/jh7110-common.dtsi
@@ -32,25 +32,6 @@ memory@40000000 {
 		bootph-pre-ram;
 	};
 
-	reserved-memory {
-		#address-cells = <2>;
-		#size-cells = <2>;
-		ranges;
-
-		/* vout applies for space from this CMA
-		 * Without this CMA reservation,
-		 * vout may not work properly.
-		 */
-		linux,cma {
-			compatible = "shared-dma-pool";
-			reusable;
-			size = <0x0 0x20000000>;
-			alignment = <0x0 0x1000>;
-			alloc-ranges = <0x0 0x70000000 0x0 0x20000000>;
-			linux,cma-default;
-		};
-	};
-
 	gpio-restart {
 		compatible = "gpio-restart";
 		gpios = <&sysgpio 35 GPIO_ACTIVE_HIGH>;
@@ -89,62 +70,6 @@ &cpus {
 	timebase-frequency = <4000000>;
 };
 
-&dc8200 {
-	status = "okay";
-	crtc_out: ports {
-		#address-cells = <1>;
-		#size-cells = <0>;
-
-		dc_out0: port@0 {
-			reg = <0>;
-			#address-cells = <1>;
-			#size-cells = <0>;
-
-			dc_out_dpi0: endpoint@0 {
-				reg = <0>;
-				remote-endpoint = <&hdmi_enc>;
-			};
-
-		};
-
-		dc_out1: port@1 {
-			reg = <1>;
-			#address-cells = <1>;
-			#size-cells = <0>;
-
-			dc_out_dpi1: endpoint@1 {
-				reg = <1>;
-				remote-endpoint = <&dsi_enc>;
-			};
-
-		};
-	};
-};
-
-&dsi_encoder {
-	status = "okay";
-
-	ports {
-		#address-cells = <1>;
-		#size-cells = <0>;
-		/* input */
-		enc_in: port@0 {
-			#address-cells = <1>;
-			#size-cells = <0>;
-			reg = <0>;
-			dsi_enc:endpoint@0 {
-				reg = <0>;
-				remote-endpoint = <&dc_out_dpi1>;
-			};
-		};
-		/* output */
-		enc_out: port@1 {
-			reg = <1>;
-			/*need add a remote-endpoint to dsi bridge*/
-		};
-	};
-};
-
 &dvp_clk {
 	clock-frequency = <74250000>;
 };
@@ -165,28 +90,6 @@ &gmac1_rmii_refin {
 	clock-frequency = <50000000>;
 };
 
-&hdmi {
-	status = "okay";
-	pinctrl-names = "default";
-	pinctrl-0 = <&hdmi_pins>;
-
-	ports {
-		#address-cells = <1>;
-		#size-cells = <0>;
-
-		hdmi_in: port@0 {
-			reg = <0>;
-			hdmi_enc: endpoint {
-				remote-endpoint = <&dc_out_dpi0>;
-			};
-		};
-
-		hdmi_out: port@1 {
-			reg = <1>;
-		};
-        };
-};
-
 &hdmitx0_pixelclk {
 	clock-frequency = <297000000>;
 };
@@ -476,40 +379,6 @@ &syscrg {
 };
 
 &sysgpio {
-	hdmi_pins: hdmi-0 {
-		hdmi-cec-pins {
-			pinmux = <GPIOMUX(14, GPOUT_SYS_HDMI_CEC_SDA,
-					     GPOEN_SYS_HDMI_CEC_SDA,
-					     GPI_SYS_HDMI_CEC_SDA)>;
-			input-enable;
-			bias-pull-up;
-		};
-
-		hdmi-hpd-pins {
-			pinmux = <GPIOMUX(15, GPOUT_HIGH,
-					     GPOEN_ENABLE,
-					     GPI_SYS_HDMI_HPD)>;
-			input-enable;
-			bias-disable; /* external pull-up */
-		};
-
-		hdmi-scl-pins {
-			pinmux = <GPIOMUX(0, GPOUT_SYS_HDMI_DDC_SCL,
-					     GPOEN_SYS_HDMI_DDC_SCL,
-					     GPI_SYS_HDMI_DDC_SCL)>;
-			input-enable;
-			bias-pull-up;
-		};
-
-		hdmi-sda-pins {
-			pinmux = <GPIOMUX(1, GPOUT_SYS_HDMI_DDC_SDA,
-					     GPOEN_SYS_HDMI_DDC_SDA,
-					     GPI_SYS_HDMI_DDC_SDA)>;
-			input-enable;
-			bias-pull-up;
-		};
-	};
-
 	i2c0_pins: i2c0-0 {
 		i2c-pins {
 			pinmux = <GPIOMUX(57, GPOUT_LOW,
@@ -799,7 +668,3 @@ &U74_3 {
 &U74_4 {
 	cpu-supply = <&vdd_cpu>;
 };
-
-&voutcrg {
-	status = "okay";
-};
diff --git a/arch/riscv/boot/dts/starfive/jh7110.dtsi b/arch/riscv/boot/dts/starfive/jh7110.dtsi
index da2a0a9dc0d9..0ba74ef04679 100644
--- a/arch/riscv/boot/dts/starfive/jh7110.dtsi
+++ b/arch/riscv/boot/dts/starfive/jh7110.dtsi
@@ -344,10 +344,6 @@ tdm_ext: tdm-ext-clock {
 		#clock-cells = <0>;
 	};
 
-	dsi_encoder: dsi_encoder {
-		compatible = "starfive,dsi-encoder";
-		starfive,syscon = <&vout_syscon 0x8 0x08>;
-	};
 	soc {
 		compatible = "simple-bus";
 		interrupt-parent = <&plic>;
@@ -581,15 +577,13 @@ usb0: usb@10100000 {
 				 <&stgcrg JH7110_STGCLK_USB0_STB>,
 				 <&stgcrg JH7110_STGCLK_USB0_APB>,
 				 <&stgcrg JH7110_STGCLK_USB0_AXI>,
-				 <&stgcrg JH7110_STGCLK_USB0_UTMI_APB>,
-				 <&stgcrg JH7110_STGCLK_PCIE0_APB>;
-			clock-names = "lpm", "stb", "apb", "axi", "utmi_apb", "phy";
+				 <&stgcrg JH7110_STGCLK_USB0_UTMI_APB>;
+			clock-names = "lpm", "stb", "apb", "axi", "utmi_apb";
 			resets = <&stgcrg JH7110_STGRST_USB0_PWRUP>,
 				 <&stgcrg JH7110_STGRST_USB0_APB>,
 				 <&stgcrg JH7110_STGRST_USB0_AXI>,
-				 <&stgcrg JH7110_STGRST_USB0_UTMI_APB>,
-				 <&stgcrg JH7110_STGRST_PCIE0_APB>;
-			reset-names = "pwrup", "apb", "axi", "utmi_apb", "phy";
+				 <&stgcrg JH7110_STGRST_USB0_UTMI_APB>;
+			reset-names = "pwrup", "apb", "axi", "utmi_apb";
 			status = "disabled";
 
 			usb_cdns3: usb@0 {
@@ -1209,48 +1203,6 @@ camss: isp@19840000 {
 			status = "disabled";
 		};
 
-		dc8200: lcd-controller@29400000 {
-			compatible = "starfive,jh7110-dc8200";
-			reg = <0x0 0x29400000 0x0 0x100>,
-			      <0x0 0x29400800 0x0 0x2000>;
-
-			interrupts = <95>;
-			clocks = <&syscrg JH7110_SYSCLK_NOC_BUS_DISP_AXI>,
-				<&voutcrg JH7110_VOUTCLK_DC8200_CORE>,
-				<&voutcrg JH7110_VOUTCLK_DC8200_AXI>,
-				<&voutcrg JH7110_VOUTCLK_DC8200_AHB>,
-				<&voutcrg JH7110_VOUTCLK_DC8200_PIX0>,
-				<&voutcrg JH7110_VOUTCLK_DC8200_PIX1>,
-				<&hdmitx0_pixelclk>,
-				<&voutcrg JH7110_VOUTCLK_DC8200_PIX>;
-			clock-names = "noc_bus", "dc_core", "axi_core", "ahb",
-				      "channel0", "channel1", "hdmi_tx", "dc_parent";
-
-			resets = <&syscrg JH7110_SYSRST_NOC_BUS_DISP_AXI>,
-				 <&syscrg JH7110_SYSRST_VOUT_TOP_SRC>,
-				 <&voutcrg JH7110_VOUTRST_DC8200_AXI>,
-				 <&voutcrg JH7110_VOUTRST_DC8200_AHB>,
-				 <&voutcrg JH7110_VOUTRST_DC8200_CORE>;
-			reset-names = "noc" ,"src" , "axi" ,"ahb", "core";
-		};
-
-		hdmi: hdmi@29590000 {
-			compatible = "starfive,jh7110-inno-hdmi";
-			reg = <0x0 0x29590000 0x0 0x4000>;
-			interrupts = <99>;
-
-			clocks = <&voutcrg JH7110_VOUTCLK_HDMI_TX_SYS>,
-				 <&voutcrg JH7110_VOUTCLK_HDMI_TX_MCLK>,
-				 <&voutcrg JH7110_VOUTCLK_HDMI_TX_BCLK>;
-			clock-names = "sysclk", "mclk", "bclk";
-			resets = <&voutcrg JH7110_VOUTRST_HDMI_TX_HDMI>;
-		};
-
-		vout_syscon: syscon@295b0000 {
-			compatible = "starfive,jh7110-vout-syscon", "syscon";
-			reg = <0 0x295b0000 0 0x90>;
-		};
-
 		voutcrg: clock-controller@295c0000 {
 			compatible = "starfive,jh7110-voutcrg";
 			reg = <0x0 0x295c0000 0x0 0x10000>;
