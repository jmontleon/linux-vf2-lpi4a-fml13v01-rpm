From 48f6c35e51ca2acb5f2412a2eb3921b6132dd707 Mon Sep 17 00:00:00 2001
From: Emil Renner Berthing <emil.renner.berthing@canonical.com>
Date: Sun, 13 Oct 2024 01:52:18 +0200
Subject: [PATCH 46/47] riscv: dts: thead: Add various TH1520 peripheral resets

Signed-off-by: Emil Renner Berthing <emil.renner.berthing@canonical.com>
---
 arch/riscv/boot/dts/thead/th1520.dtsi | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/riscv/boot/dts/thead/th1520.dtsi b/arch/riscv/boot/dts/thead/th1520.dtsi
index 85520ca700b8..00e9ecf92bf9 100644
--- a/arch/riscv/boot/dts/thead/th1520.dtsi
+++ b/arch/riscv/boot/dts/thead/th1520.dtsi
@@ -6,6 +6,7 @@
 
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/clock/thead,th1520-clk-ap.h>
+#include <dt-bindings/reset/thead,th1520-reset.h>
 
 / {
 	compatible = "thead,th1520";
@@ -264,6 +265,8 @@ spi0: spi@ffe700c000 {
 			reg = <0xff 0xe700c000 0x0 0x1000>;
 			interrupts = <54 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_SPI>;
+			resets = <&aprst APRST_SPI>;
+			reset-names = "spi";
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
@@ -275,6 +278,7 @@ uart0: serial@ffe7014000 {
 			interrupts = <36 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_UART_SCLK>, <&clk CLK_UART0_PCLK>;
 			clock-names = "baudclk", "apb_pclk";
+			resets = <&aprst APRST_UART0>;
 			reg-shift = <2>;
 			reg-io-width = <4>;
 			status = "disabled";
@@ -357,6 +361,7 @@ uart1: serial@ffe7f00000 {
 			interrupts = <37 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_UART_SCLK>, <&clk CLK_UART1_PCLK>;
 			clock-names = "baudclk", "apb_pclk";
+			resets = <&aprst APRST_UART1>;
 			reg-shift = <2>;
 			reg-io-width = <4>;
 			status = "disabled";
@@ -368,6 +373,7 @@ uart3: serial@ffe7f04000 {
 			interrupts = <39 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_UART_SCLK>, <&clk CLK_UART3_PCLK>;
 			clock-names = "baudclk", "apb_pclk";
+			resets = <&aprst APRST_UART3>;
 			reg-shift = <2>;
 			reg-io-width = <4>;
 			status = "disabled";
@@ -378,6 +384,7 @@ i2c0: i2c@ffe7f20000 {
 			reg = <0xff 0xe7f20000 0x0 0x4000>;
 			interrupts = <44 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_I2C0>;
+			resets = <&aprst APRST_I2C0>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
@@ -388,6 +395,7 @@ i2c1: i2c@ffe7f24000 {
 			reg = <0xff 0xe7f24000 0x0 0x4000>;
 			interrupts = <45 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_I2C1>;
+			resets = <&aprst APRST_I2C1>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
@@ -398,6 +406,7 @@ i2c4: i2c@ffe7f28000 {
 			reg = <0xff 0xe7f28000 0x0 0x4000>;
 			interrupts = <48 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_I2C4>;
+			resets = <&aprst APRST_I2C4>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
@@ -410,6 +419,7 @@ gpio@ffe7f34000 {
 			#size-cells = <0>;
 			clocks = <&clk CLK_GPIO2>;
 			clock-names = "bus";
+			resets = <&aprst APRST_GPIO2>;
 
 			gpio2: gpio-controller@0 {
 				compatible = "snps,dw-apb-gpio-port";
@@ -431,6 +441,7 @@ gpio@ffe7f38000 {
 			#size-cells = <0>;
 			clocks = <&clk CLK_GPIO3>;
 			clock-names = "bus";
+			resets = <&aprst APRST_GPIO3>;
 
 			gpio3: gpio-controller@0 {
 				compatible = "snps,dw-apb-gpio-port";
@@ -449,6 +460,7 @@ padctrl1_apsys: pinctrl@ffe7f3c000 {
 			compatible = "thead,th1520-pinctrl";
 			reg = <0xff 0xe7f3c000 0x0 0x1000>;
 			clocks = <&clk CLK_PADCTRL1>;
+			resets = <&aprst APRST_PADCTRL1_APSYS>;
 			thead,pad-group = <2>;
 		};
 
@@ -459,6 +471,7 @@ gpio@ffec005000 {
 			#size-cells = <0>;
 			clocks = <&clk CLK_GPIO0>;
 			clock-names = "bus";
+			resets = <&aprst APRST_GPIO0>;
 
 			gpio0: gpio-controller@0 {
 				compatible = "snps,dw-apb-gpio-port";
@@ -480,6 +493,7 @@ gpio@ffec006000 {
 			#size-cells = <0>;
 			clocks = <&clk CLK_GPIO1>;
 			clock-names = "bus";
+			resets = <&aprst APRST_GPIO1>;
 
 			gpio1: gpio-controller@0 {
 				compatible = "snps,dw-apb-gpio-port";
@@ -498,6 +512,7 @@ padctrl0_apsys: pinctrl@ffec007000 {
 			compatible = "thead,th1520-pinctrl";
 			reg = <0xff 0xec007000 0x0 0x1000>;
 			clocks = <&clk CLK_PADCTRL0>;
+			resets = <&aprst APRST_PADCTRL0_APSYS>;
 			thead,pad-group = <3>;
 		};
 
@@ -506,6 +521,7 @@ i2c2: i2c@ffec00c000 {
 			reg = <0xff 0xec00c000 0x0 0x4000>;
 			interrupts = <46 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_I2C2>;
+			resets = <&aprst APRST_I2C2>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
@@ -517,6 +533,7 @@ uart2: serial@ffec010000 {
 			interrupts = <38 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_UART_SCLK>, <&clk CLK_UART2_PCLK>;
 			clock-names = "baudclk", "apb_pclk";
+			resets = <&aprst APRST_UART2>;
 			reg-shift = <2>;
 			reg-io-width = <4>;
 			status = "disabled";
@@ -527,6 +544,7 @@ i2c3: i2c@ffec014000 {
 			reg = <0xff 0xec014000 0x0 0x4000>;
 			interrupts = <47 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_I2C3>;
+			resets = <&aprst APRST_I2C3>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
@@ -537,6 +555,7 @@ pwm: pwm@ffec01c000 {
 			reg = <0xff 0xec01c000 0x0 0x4000>;
 			#pwm-cells = <3>;
 			clocks = <&clk CLK_PWM>;
+			resets = <&aprst APRST_PWM>;
 		};
 
 		misc_sysreg: misc_sysreg@ffec02c000 {
@@ -590,6 +609,7 @@ timer0: timer@ffefc32000 {
 			reg = <0xff 0xefc32000 0x0 0x14>;
 			clocks = <&clk CLK_PERI_APB_PCLK>;
 			clock-names = "timer";
+			resets = <&aprst APRST_TIMER0>;
 			interrupts = <16 IRQ_TYPE_LEVEL_HIGH>;
 			status = "disabled";
 		};
@@ -599,6 +619,7 @@ timer1: timer@ffefc32014 {
 			reg = <0xff 0xefc32014 0x0 0x14>;
 			clocks = <&clk CLK_PERI_APB_PCLK>;
 			clock-names = "timer";
+			resets = <&aprst APRST_TIMER1>;
 			interrupts = <17 IRQ_TYPE_LEVEL_HIGH>;
 			status = "disabled";
 		};
@@ -627,6 +648,7 @@ uart4: serial@fff7f08000 {
 			interrupts = <40 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_UART_SCLK>, <&clk CLK_UART4_PCLK>;
 			clock-names = "baudclk", "apb_pclk";
+			resets = <&aprst APRST_UART4>;
 			reg-shift = <2>;
 			reg-io-width = <4>;
 			status = "disabled";
@@ -638,6 +660,7 @@ uart5: serial@fff7f0c000 {
 			interrupts = <41 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_UART_SCLK>, <&clk CLK_UART5_PCLK>;
 			clock-names = "baudclk", "apb_pclk";
+			resets = <&aprst APRST_UART5>;
 			reg-shift = <2>;
 			reg-io-width = <4>;
 			status = "disabled";
@@ -648,6 +671,7 @@ i2c5: i2c@fff7f2c000 {
 			reg = <0xff 0xf7f2c000 0x0 0x4000>;
 			interrupts = <49 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk CLK_I2C5>;
+			resets = <&aprst APRST_I2C5>;
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
@@ -716,6 +740,7 @@ gpio@fffff41000 {
 			reg = <0xff 0xfff41000 0x0 0x1000>;
 			#address-cells = <1>;
 			#size-cells = <0>;
+			resets = <&aonrst AONRST_AOGPIO>;
 
 			aogpio: gpio-controller@0 {
 				compatible = "snps,dw-apb-gpio-port";
@@ -751,6 +776,7 @@ pvt: pvt@fffff4e000 {
 			      <0xff 0xfff4e800 0x0 0x600>;
 			reg-names = "common", "ts", "pd", "vm";
 			clocks = <&aonsys_clk>;
+			resets = <&aonrst AONRST_PVTC>;
 			#thermal-sensor-cells = <1>;
 		};
 
@@ -759,6 +785,7 @@ gpio@fffff52000 {
 			reg = <0xff 0xfff52000 0x0 0x1000>;
 			#address-cells = <1>;
 			#size-cells = <0>;
+			resets = <&aonrst AONRST_AUDGPIO>;
 
 			gpio4: gpio-controller@0 {
 				compatible = "snps,dw-apb-gpio-port";
